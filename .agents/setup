#!/usr/bin/env bash
# Prerequisites for the optional Android renderer and fidelity benchmark tools.
set -euo pipefail

if ! command -v java >/dev/null || ! command -v mvn >/dev/null || ! command -v zip >/dev/null; then
  sudo apt-get update -qq
  sudo apt-get install -y -qq default-jdk maven zip
fi

if ! command -v android >/dev/null; then
  curl -fsSL https://dl.google.com/android/cli/latest/linux_x86_64/install.sh | bash
fi

if ! command -v cargo >/dev/null; then
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
fi

ANDROID_SDK_ROOT="${ANDROID_SDK_ROOT:-$HOME/Android/Sdk}"
android sdk install platform-tools platforms/android-35 build-tools/35.0.0
ln -sf "$ANDROID_SDK_ROOT/platform-tools/adb" "$HOME/.local/bin/adb"
