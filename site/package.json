{
  "name": "vdtoolkit-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build ../bindings/wasm --target web --release --out-dir ../../site/vendor/vdtoolkit-wasm",
    "build": "npm run build:wasm && node build.mjs",
    "build:site": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "canvaskit-wasm": "0.42.0"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "esbuild": "0.25.9",
    "typescript": "5.9.2"
  }
}
